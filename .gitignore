# Local Taiji / Wuji runtime (config, sessions, memory, skills cache)
.taiji/
.wuji/

# Backend (taiji-ai) — CLI + eval tools
taiji-ai/bin/
taiji-ai/*.test
taiji-ai/agent.test

# Eval / bench binaries (if built with go build -o outside bin/)
/decision-eval
/memory-eval
/memory-bench
/memory-scenario-eval

# Frontend (taiji-tui) — TUI binary + embedded Go archive
taiji-tui/build/
taiji-tui/build/taiji-tui
taiji-tui/fuzzy/target/
taiji-tui/highlight/target/
**/libtaiji.a
**/libtaiji.h

# Local clone of the Wuji CLI (separate repo; not vendored in Taiji)
/wuji-ai/

# Go
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
*.out
coverage.*
*.coverprofile
profile.cov
.cache/
go.work
go.work.sum

# Secrets and env overrides
.env
.env.*
!.env.example

# Logs and temp files
*.log
tmp/
temp/

# Editor / OS
.DS_Store
Thumbs.db
*~
.idea/
.vscode/
*.swp
*.swo
